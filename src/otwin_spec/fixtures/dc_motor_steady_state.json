    }
  ],
  "derived_quantities": {
    "omega_ss_rad_s": 14.285714285714286,
    "I_ss_A": 2.857142857142857,
    "note": "omega = p/inertia and I = phi/L; the fixture checks the energy variables directly so it does not depend on an implementation's choice of output map."
  }
