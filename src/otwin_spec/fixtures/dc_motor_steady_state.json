    "inertia": 0.01,
    "Re": 1.0,
    "b": 0.1,
    "K": 0.5
  },
  "state_names": [
    "phi",
    "p"
  ],
  "scenario": {
    "x0": [
      0.0,
      0.0
    ],
    "t": {
      "start": 0.0,
      "stop": 5.0,
      "num": 2001
    },
    "u": {
      "kind": "constant",
      "value": [
        10.0
      ]
    }
  },
  "checks": [
    {
      "id": "phi_steady_state",
      "kind": "final_value",
      "quantity": "state",
      "index": 0,
      "expected": 1.4285714285714286,
      "rel_tol": 1e-05,
      "closed_form": "phi_ss = L * V * b / (Re*b + K^2)"
    },
    {
      "id": "p_steady_state",
      "kind": "final_value",
      "quantity": "state",
      "index": 1,
      "expected": 0.14285714285714288,
      "rel_tol": 1e-05,
      "closed_form": "p_ss = inertia * V * K / (Re*b + K^2)"
    },
    {
      "id": "J_skew",
      "kind": "matrix_skew_symmetric",
      "matrix": "J",
      "abs_tol": 1e-12,
